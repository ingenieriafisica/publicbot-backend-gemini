{
    "name": "publicbot-backend",
    "version": "2.1.8",
    "description": "backend con RAG para el chatbot público",
    "author": "CSGE",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "seed:admin": "ts-node src/scripts/seed-admin.ts",
        "migrate:embeddings": "ts-node src/scripts/reembed-to-gemini.ts"
    },
    "dependencies": {
        "@google/genai": "^2.30.0",
        "@langchain/community": "^0.3.14",
        "@langchain/core": "^0.3.70",
        "@langchain/groq": "^0.1.2",
        "@langchain/langgraph": "^0.2.20",
        "@langchain/langgraph-checkpoint-mongodb": "^0.0.4",
        "@langchain/mongodb": "^0.1.0",
        "@nestjs/axios": "^12.0.1",
        "@nestjs/common": "^12.1.2",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.1.2",
        "@nestjs/jwt": "^12.0.2",
        "@nestjs/mapped-types": "^12.0.0",
        "@nestjs/mongoose": "^12.0.0",
        "@nestjs/passport": "^12.0.0",
        "@nestjs/platform-express": "^12.1.2",
        "@nestjs/swagger": "^12.0.2",
        "@nestjs/throttler": "^6.7.1",
        "@types/nodemailer": "^8.0.2",
        "@willsoto/nestjs-prometheus": "^6.1.1",
        "axios": "^1.7.3",
        "bcryptjs": "^2.4.3",
        "cheerio": "^1.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.4.5",
        "groq-sdk": "^0.7.0",
        "helmet": "^8.3.0",
        "html-to-text": "^9.0.5",
        "ioredis": "^5.8.2",
        "jsdom": "^25.0.1",
        "langchain": "^0.3.5",
        "mongoose": "^8.5.2",
        "mongoose-aggregate-paginate-v2": "^1.1.2",
        "mongoose-delete": "^1.0.2",
        "mongoose-paginate-v2": "^1.8.3",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^10.0.13",
        "openai": "^4.55.7",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pdf-parse": "^1.1.1",
        "pdfkit": "^0.15.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.0",
        "rxjs": "^7.8.1",
        "unstructured-client": "^0.18.2",
        "uuid": "^10.0.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@compodoc/compodoc": "^1.1.30",
        "@nestjs/cli": "^12.0.8",
        "@nestjs/schematics": "^12.0.6",
        "@nestjs/testing": "^12.1.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.2",
        "@types/multer": "^2.0.0",
        "@types/node": "^20.3.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "@types/supertest": "^6.0.0",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.5.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.0",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}