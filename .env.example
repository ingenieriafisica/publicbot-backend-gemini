# ==========================================
# PUBLICBOT BACKEND - ENVIRONMENT VARIABLES
# ==========================================

# ── Servidor y Red ────────────────────────
PORT=3222
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:4222,http://127.0.0.1:4222,http://localhost:3000,http://127.0.0.1:3000

# ── Autenticación y Seguridad (JWT y OTP) ─
JWT_SECRET=tu_clave_secreta_jwt
OTP_EXPIRATION_MINUTES=5

# ── Configuración Mail (SMTP / Gmail) ─────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password
MAIL_FROM="PublicBot Gemini" <tu_correo@gmail.com>

# ── Base de Datos MongoDB Atlas ───────────
MONGODB_ATLAS_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_ATLAS_DB_NAME=publicbotdb
MONGODB_ATLAS_COLLECTION_NAME=geminivectors
MONGODB_ATLAS_LOCAL_COLLECTION_NAME=geminivectors

# ── Servicio de IA (Google Gemini API) ─────
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_DEFAULT_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768

# ── Parámetros de Fragmentación y Vectores 
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
VECTOR_DIMENSIONS=768

# ── Parámetros de Inferencia y RAG ────────
CHATBOTAI_TOP_K=5
CHATBOTAI_TOP_RERANK=3
CHATBOTAI_TEMPERATURA=0.2
CHATBOTAI_MAX_TOKENS=128000

# ── Cache y Lista Negra de Tokens (Redis) ─
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Asistente de Voz SOFIA (ESP32-S3) ─────
DEVICE_API_KEY=sofia-secret-device-key-2026
GEMINI_VOICE_MODEL=gemini-3.8-live
GEMINI_VOICE_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_TTS_FALLBACK_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE_NAME=Aoede

